if [ -d /etc/X11/xinit/xinitrc.d ] ; then
    for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
        [ -x "$f" ] && . "$f"
    done
    unset f
fi

# map right super key to compose
setxkbmap -option compose:rwin
# map numpad comma (german keyboard) to dot instead
setxkbmap -option kpdl:dot

xrandr --output DP-3 --mode 1920x1080 --rate 75 --rotate left --left-of DP-0
xrandr --output DP-2 --mode 1920x1080 --rate 75 --right-of DP-1

xrdb --merge "XDG_CONFIG_HOME/X11/XResources"

ibus-daemon -drx --xim

mkdir /tmp/log

systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP

systemctl --user daemon-reload
systemctl --user start i3-session.service

i3 &> /dev/null

systemctl --user stop i3-session.service
